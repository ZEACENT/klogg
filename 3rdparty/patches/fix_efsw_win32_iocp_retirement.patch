--- /dev/null
+++ b/src/efsw/DirectoryIoLifetime.hpp
@@ -0,0 +1,145 @@
+#ifndef EFSW_DIRECTORYIOLIFETIME_HPP
+#define EFSW_DIRECTORYIOLIFETIME_HPP
+
+#include <cstddef>
+#include <cstdint>
+#include <unordered_map>
+
+namespace efsw {
+
+class DirectoryIoLifetime {
+  public:
+	struct Token {
+		Token( void* tokenValue = nullptr, std::uint64_t tokenGeneration = 0 ) :
+			value( tokenValue ), generation( tokenGeneration ) {}
+
+		void* value;
+		std::uint64_t generation;
+	};
+
+	enum class Completion {
+		Ignored,
+		Retired,
+		Failed,
+		Dispatch
+	};
+
+	Token registerWatch( void* value ) {
+		if ( value == nullptr || mEntries.find( value ) != mEntries.end() )
+			return Token{};
+
+		const std::uint64_t generation = ++mNextGeneration;
+		mEntries.emplace( value, Entry{ generation, true, false, false } );
+		return Token{ value, generation };
+	}
+
+	bool beginSubmission( Token token ) {
+		Entry* entry = find( token );
+		if ( entry == nullptr || !entry->active || entry->pending )
+			return false;
+
+		entry->pending = true;
+		return true;
+	}
+
+	bool submissionFailed( Token token ) {
+		Entry* entry = find( token );
+		if ( entry == nullptr || !entry->pending )
+			return false;
+
+		entry->pending = false;
+		entry->active = false;
+		return readyToDestroy( token );
+	}
+
+	bool retire( Token token ) {
+		Entry* entry = find( token );
+		if ( entry == nullptr || !entry->active )
+			return false;
+
+		entry->active = false;
+		return entry->pending;
+	}
+
+	Completion completionDequeued( Token token, bool succeeded ) {
+		Entry* entry = find( token );
+		if ( entry == nullptr || !entry->pending )
+			return Completion::Ignored;
+
+		entry->pending = false;
+		entry->dispatching = true;
+		if ( !succeeded && entry->active ) {
+			entry->active = false;
+			return Completion::Failed;
+		}
+		if ( entry->active )
+			return Completion::Dispatch;
+
+		return Completion::Retired;
+	}
+
+	bool dispatchAllowed( Token token ) const {
+		const Entry* entry = find( token );
+		return entry != nullptr && entry->active && entry->dispatching;
+	}
+
+	bool finishDispatch( Token token ) {
+		Entry* entry = find( token );
+		if ( entry == nullptr || !entry->dispatching )
+			return false;
+
+		entry->dispatching = false;
+		return readyToDestroy( token );
+	}
+
+	bool readyToDestroy( Token token ) const {
+		const Entry* entry = find( token );
+		return entry != nullptr && !entry->active && !entry->pending && !entry->dispatching;
+	}
+
+	bool destroy( Token token ) {
+		if ( !readyToDestroy( token ) )
+			return false;
+
+		mEntries.erase( token.value );
+		return true;
+	}
+
+	std::size_t retiredCount() const {
+		std::size_t count = 0;
+		for ( const auto& entry : mEntries ) {
+			if ( !entry.second.active )
+				++count;
+		}
+		return count;
+	}
+
+  private:
+	struct Entry {
+		std::uint64_t generation;
+		bool active;
+		bool pending;
+		bool dispatching;
+	};
+
+	Entry* find( Token token ) {
+		auto it = mEntries.find( token.value );
+		if ( it == mEntries.end() || it->second.generation != token.generation )
+			return nullptr;
+		return &it->second;
+	}
+
+	const Entry* find( Token token ) const {
+		auto it = mEntries.find( token.value );
+		if ( it == mEntries.end() || it->second.generation != token.generation )
+			return nullptr;
+		return &it->second;
+	}
+
+	std::unordered_map<void*, Entry> mEntries;
+	std::uint64_t mNextGeneration = 0;
+};
+
+} // namespace efsw
+
+#endif
