---
# Permissive clang-tidy baseline for the klogg C++/Qt codebase.
#
# Goal: a green-from-day-one gate (.github/workflows/static-analysis.yml runs
# clang-tidy with --warnings-as-errors='*') that catches genuine defects and
# regressions on changed code without drowning a large legacy Qt codebase in
# stylistic noise.  The high-signal subset of the modernize / bugprone /
# performance / readability / cert / cppcoreguidelines groups is enabled; the
# checks that fire broadly on existing Qt/C++ code are suppressed below and can
# be re-enabled one at a time as the affected code is cleaned up (remove a
# `-check-name` line to start enforcing it, then fix or NOLINT the findings).
#
# Run locally:  clang-tidy -p build_root <file.cpp>
# Checks are read from this file automatically.

Checks: >
  -*,
  bugprone-*,
  cert-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -cert-err58-cpp,
  -cert-err60-cpp,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-init-variables,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-cstyle-cast,
  -cppcoreguidelines-pro-type-const-cast,
  -cppcoreguidelines-pro-type-member-init,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-special-member-functions,
  -modernize-avoid-bind,
  -modernize-avoid-c-arrays,
  -modernize-loop-convert,
  -modernize-macro-to-enum,
  -modernize-pass-by-value,
  -modernize-use-default-member-init,
  -modernize-use-emplace,
  -modernize-use-nodiscard,
  -modernize-use-override,
  -modernize-use-trailing-return-type,
  -modernize-use-transparent-comparisons,
  -modernize-use-using,
  -performance-no-int-to-ptr,
  -performance-type-promotion-in-math-expression,
  -performance-unnecessary-value-param,
  -readability-braces-around-statements,
  -readability-convert-member-functions-to-static,
  -readability-else-after-return,
  -readability-function-cognitive-complexity,
  -readability-identifier-naming,
  -readability-implicit-bool-conversion,
  -readability-isolate-declaration,
  -readability-magic-numbers,
  -readability-named-parameter,
  -readability-qualified-auto,
  -readability-redundant-access-specifiers,
  -readability-redundant-string-cstr,
  -readability-simplify-boolean-expr,
  -readability-uppercase-literal-suffix

# Only analyse first-party headers under src/<module>/ -- either directly
# (src/app/kloggapp.h) or nested under include/ / src/.  This excludes vendored
# CPM-cache packages (which carry their own src/ trees), the generated build
# tree (build_root/.../*_autogen/, whose paths have an extra segment before
# include/), 3rd-party deps and Qt system headers.  llvm::Regex has no lookahead,
# so the match is anchored on the known src/ module names; add a new top-level
# module here when one is introduced.
HeaderFilterRegex: '.*/src/(app|crash_handler|filewatch|klogg_version|logdata|logging|regex|settings|ui|utils|versioncheck)/([^/]*\.(h|hpp)$|(include|src)/.*\.(h|hpp)$)'
