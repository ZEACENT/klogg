cmake_minimum_required(VERSION 3.14)

# The generated manifest contains paths only, never executable CMake code.
file(STRINGS "${DESTINATIONS_FILE}" helper_destinations ENCODING UTF-8)
if(NOT helper_destinations)
  message(FATAL_ERROR "The ADB helper destination manifest is empty")
endif()
foreach(destination IN LISTS helper_destinations)
  get_filename_component(directory_name "${destination}" NAME)
  if(NOT IS_ABSOLUTE "${destination}" OR NOT directory_name STREQUAL "helpers")
    message(FATAL_ERROR "Invalid ADB helper destination: ${destination}")
  endif()
endforeach()

# REALPATH alone does not resolve parents when the final path is absent. Resolve
# the nearest existing prefix first, then append its missing suffix. An existing
# file prefix is deliberately not an error here: an unrequested app may have a
# blocked output parent. Only its selected staging operation must reject it.
function(adb_canonical_path path output depth)
  if(depth GREATER 32)
    set(${output} "" PARENT_SCOPE)
    return()
  endif()
  set(prefix "${path}")
  set(suffix "")
  while(NOT EXISTS "${prefix}" AND NOT IS_SYMLINK "${prefix}")
    get_filename_component(parent "${prefix}" DIRECTORY)
    if(parent STREQUAL prefix OR parent STREQUAL "")
      set(${output} "" PARENT_SCOPE)
      return()
    endif()
    get_filename_component(name "${prefix}" NAME)
    set(suffix "/${name}${suffix}")
    set(prefix "${parent}")
  endwhile()
  if(IS_SYMLINK "${prefix}" AND NOT EXISTS "${prefix}")
    file(READ_SYMLINK "${prefix}" target)
    if(NOT IS_ABSOLUTE "${target}")
      get_filename_component(parent "${prefix}" DIRECTORY)
      set(target "${parent}/${target}")
    endif()
    math(EXPR next_depth "${depth} + 1")
    adb_canonical_path("${target}" resolved "${next_depth}")
  else()
    get_filename_component(resolved "${prefix}" REALPATH)
  endif()
  if(resolved STREQUAL "")
    set(${output} "" PARENT_SCOPE)
    return()
  endif()
  get_filename_component(resolved "${resolved}${suffix}" ABSOLUTE)
  set(${output} "${resolved}" PARENT_SCOPE)
endfunction()

function(adb_path_key path output)
  set(key "${path}")
  if(CMAKE_HOST_WIN32)
    string(REPLACE "\\" "/" key "${key}")
    string(TOLOWER "${key}" key)
  endif()
  string(REGEX REPLACE "/+$" "" key "${key}")
  set(${output} "${key}/" PARENT_SCOPE)
endfunction()

# Ownership follows the directory entry being replaced, not a final helpers
# symlink's target. Parent aliases are resolved, but rm always receives the
# original destination spelling so it cannot delete an unrelated link target.
function(adb_entry_key path output)
  get_filename_component(parent "${path}" DIRECTORY)
  get_filename_component(name "${path}" NAME)
  adb_canonical_path("${parent}" resolved 0)
  if(resolved STREQUAL "")
    set(${output} "" PARENT_SCOPE)
    return()
  endif()
  get_filename_component(entry "${resolved}/${name}" ABSOLUTE)
  adb_path_key("${entry}" key)
  set(${output} "${key}" PARENT_SCOPE)
endfunction()

# Distinct staging entries cannot contain another output or an alias needed to
# reach it. Equal leaf entries are the valid shared-owner case; parent access
# entries still need protection. This only inspects metadata, not writability.
function(adb_reject_destination_overlap owner_key other_destination)
  if(owner_key STREQUAL "")
    return()
  endif()
  set(prefix "${other_destination}")
  set(at_destination TRUE)
  while(TRUE)
    adb_entry_key("${prefix}" access_key)
    set(equal_leaf FALSE)
    if(at_destination AND access_key STREQUAL owner_key)
      set(equal_leaf TRUE)
    endif()
    if(NOT access_key STREQUAL "" AND NOT equal_leaf)
      string(FIND "${access_key}" "${owner_key}" nested_output)
      if(nested_output EQUAL 0)
        message(FATAL_ERROR "ADB helper destination paths overlap: ${other_destination}")
      endif()
    endif()
    get_filename_component(parent "${prefix}" DIRECTORY)
    if(parent STREQUAL prefix OR parent STREQUAL "")
      break()
    endif()
    set(prefix "${parent}")
    set(at_destination FALSE)
  endwhile()
endfunction()

if(NOT DEFINED STAGE_ROLE)
  set(STAGE_ROLE all)
endif()
if(NOT STAGE_ROLE STREQUAL "all")
  list(LENGTH helper_destinations destination_count)
  if(NOT destination_count EQUAL 2)
    message(FATAL_ERROR "Application staging requires exactly two destination paths")
  endif()
  list(GET helper_destinations 0 regular_destination)
  list(GET helper_destinations 1 portable_destination)
  adb_entry_key("${regular_destination}" regular_key)
  adb_entry_key("${portable_destination}" portable_key)
  foreach(destination IN LISTS helper_destinations)
    adb_reject_destination_overlap("${regular_key}" "${destination}")
    adb_reject_destination_overlap("${portable_key}" "${destination}")
  endforeach()
  set(shared FALSE)
  if(NOT regular_key STREQUAL "" AND regular_key STREQUAL portable_key)
    set(shared TRUE)
  endif()
  if(STAGE_ROLE STREQUAL "shared")
    if(NOT shared)
      return()
    endif()
    set(helper_destinations "${regular_destination}")
  elseif(STAGE_ROLE STREQUAL "klogg" OR STAGE_ROLE STREQUAL "klogg_portable")
    if(shared)
      return()
    endif()
    if(STAGE_ROLE STREQUAL "klogg")
      set(helper_destinations "${regular_destination}")
    else()
      set(helper_destinations "${portable_destination}")
    endif()
  else()
    message(FATAL_ERROR "Invalid ADB helper staging role")
  endif()
else()
  foreach(destination IN LISTS helper_destinations)
    adb_entry_key("${destination}" owner_key)
    foreach(other_destination IN LISTS helper_destinations)
      adb_reject_destination_overlap("${owner_key}" "${other_destination}")
    endforeach()
  endforeach()
endif()

if(NOT IS_ABSOLUTE "${SOURCE_HELPERS}" OR NOT IS_DIRECTORY "${SOURCE_HELPERS}")
  message(FATAL_ERROR "Cannot copy verified ADB helpers: source directory is missing")
endif()
adb_canonical_path("${SOURCE_HELPERS}" source_real 0)
adb_path_key("${source_real}" source_key)

# Also protect directory entries traversed to reach an aliased source. Deleting
# one could break the original source path even when its ultimate target lies
# outside that directory. This list is used only for ancestor-of-source checks.
set(source_access_keys)
set(source_prefix "${SOURCE_HELPERS}")
while(TRUE)
  adb_entry_key("${source_prefix}" access_key)
  if(NOT access_key STREQUAL "")
    list(APPEND source_access_keys "${access_key}")
  endif()
  get_filename_component(parent "${source_prefix}" DIRECTORY)
  if(parent STREQUAL source_prefix OR parent STREQUAL "")
    break()
  endif()
  set(source_prefix "${parent}")
endwhile()

# Validate every selected destination before the first removal. Unselected
# private directories need not exist, be writable, or pass staging validation.
set(selected_destinations)
set(selected_keys)
foreach(destination IN LISTS helper_destinations)
  adb_entry_key("${destination}" destination_entry)
  adb_canonical_path("${destination}" destination_real 0)
  if(destination_entry STREQUAL "" OR destination_real STREQUAL "")
    message(FATAL_ERROR "Cannot resolve selected ADB helper destination")
  endif()
  adb_path_key("${destination_real}" destination_key)
  foreach(key IN ITEMS "${destination_entry}" "${destination_key}")
    string(FIND "${key}" "${source_key}" destination_in_source)
    string(FIND "${source_key}" "${key}" source_in_destination)
    if(destination_in_source EQUAL 0 OR source_in_destination EQUAL 0)
      message(FATAL_ERROR "ADB helper source and destination overlap: ${destination}")
    endif()
  endforeach()
  foreach(access_key IN LISTS source_access_keys)
    string(FIND "${access_key}" "${destination_entry}" source_path_removed)
    if(source_path_removed EQUAL 0)
      message(FATAL_ERROR "ADB helper destination overlaps the verified source path: ${destination}")
    endif()
  endforeach()
  list(FIND selected_keys "${destination_entry}" existing)
  if(existing EQUAL -1)
    list(APPEND selected_keys "${destination_entry}")
    list(APPEND selected_destinations "${destination}")
  endif()
endforeach()

foreach(destination IN LISTS selected_destinations)
  execute_process(
    COMMAND "${CMAKE_COMMAND}" -E rm -rf "${destination}"
    RESULT_VARIABLE removal_result
  )
  if(NOT "${removal_result}" STREQUAL "0")
    message(FATAL_ERROR "Removing stale ADB helpers failed: ${destination}")
  endif()
  execute_process(
    COMMAND "${CMAKE_COMMAND}" -E copy_directory "${SOURCE_HELPERS}" "${destination}"
    RESULT_VARIABLE copy_result
  )
  if(NOT "${copy_result}" STREQUAL "0")
    message(FATAL_ERROR "Copying verified ADB helpers failed: ${destination}")
  endif()
endforeach()
