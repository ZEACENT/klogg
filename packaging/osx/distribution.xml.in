<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Klogg log viewer</title>
    <license file="COPYING"/>
    <welcome file="description.txt"/>
    
    <pkg-ref id="@KLOGG_APPLICATION_ID@"/>
    <options customize="never" require-scripts="false"/>
    <choices-outline>
        <line choice="default">
            <line choice="@KLOGG_APPLICATION_ID@"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="@KLOGG_APPLICATION_ID@" visible="false">
        <pkg-ref id="@KLOGG_APPLICATION_ID@"/>
    </choice>
    <pkg-ref id="@KLOGG_APPLICATION_ID@" version="%klogg_version%" onConclusion="none">%klogg_pkg%</pkg-ref>
</installer-gui-script>
